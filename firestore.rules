rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- 🔹 HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // ✅ FIXED: Added existence checks to prevent crashes on new users
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isTeacher() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    // Approved teachers (newer accounts: status 'approved'; older ones: approved == true).
    function isApprovedTeacher() {
      return isTeacher() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') == 'approved' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('approved', false) == true
      );
    }
    // The course's teacher, an enrolled student or an admin.
    function isCourseMember(courseId) {
      let course = get(/databases/$(database)/documents/courses/$(courseId)).data;
      return isSignedIn() && (
        course.teacherId == request.auth.uid ||
        request.auth.uid in course.get('enrolledStudents', []) ||
        isAdmin()
      );
    }

    // Counters other users may move on someone's profile: follows by one,
    // ratings by one review (reviewCount ±1 or 0 for an edited review,
    // totalStars by at most 5), never below zero.
    function delta(field) {
      return request.resource.data.get(field, 0) - resource.data.get(field, 0);
    }
    // Bank / CliQ details are private (users/{uid}/private/payout). They must never
    // be (re)written onto the public users / teachers documents — not even by old app versions.
    function writesPayoutPublicly() {
      return request.resource.data.keys().hasAny(['payoutSettings']) &&
        (resource == null || request.resource.data.diff(resource.data).affectedKeys().hasAny(['payoutSettings']));
    }
    // Follow counters only. Rating totals (totalStars / reviewCount) are
    // computed by the server from the reviews (functions/ratings.js); the app
    // can no longer add or remove stars (anyone could, ±5 per write).
    function isPublicCounterUpdate() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return keys.hasOnly(['followerCount', 'followingCount']) &&
        delta('followerCount') in [-1, 0, 1] &&
        delta('followingCount') in [-1, 0, 1] &&
        request.resource.data.get('followerCount', 0) >= 0 &&
        request.resource.data.get('followingCount', 0) >= 0;
    }

    // =========================================================
    // 🌍 PUBLIC REGISTRIES (Uniqueness Locks)
    // =========================================================
    
    match /locked_usernames/{username} {
      allow get: if true; 
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && request.resource.data.uid == request.auth.uid && resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /locked_emails/{email} {
      allow get: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && request.resource.data.uid == request.auth.uid && resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /locked_phones/{phone} {
      allow get: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && request.resource.data.uid == request.auth.uid && resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // =========================================================
    // 👤 USERS PROFILE (The Master List)
    // =========================================================
    match /users/{userId} {
      allow read: if true;
      
      // ✅ FIXED: Allow initial document creation without a role (for FCM token save)
      allow create: if isOwner(userId) && !writesPayoutPublicly() && (
        (request.resource.data.role == 'student') || 
        (request.resource.data.role == 'teacher' && request.resource.data.status == 'pending') ||
        request.resource.data.keys().hasOnly(['fcmToken', 'preferredLanguage', 'lastTokenUpdate'])
      );
      
      allow delete: if isAdmin();
      
      // ✅ FIXED: Allow owner to set their role for the first time
      allow update: if isSignedIn() && !writesPayoutPublicly() && (
        isAdmin() || 
        (isOwner(userId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'commissionRate', 'totalStars', 'reviewCount']) ||
          (!resource.data.keys().hasAny(['role']) && request.resource.data.role in ['student', 'teacher'])
        )) ||
        isPublicCounterUpdate()
      );

      match /followers/{followerId} {
        allow read: if true;
        allow create, delete: if isOwner(followerId);
      }
      match /following/{followingId} {
        allow read: if true;
        allow create, delete: if isOwner(userId);
      }

      // How often the rating pop-up asked about each course (CourseRatings).
      match /rating_prompts/{courseId} {
        allow read, write: if isOwner(userId);
      }

      match /saved_posts/{postId} {
        allow read, create: if isOwner(userId);
        // Admins too: deleting a post removes its author's bookmark of it.
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /notifications/{notificationId} {
        allow read, update: if isOwner(userId);
        allow delete: if isOwner(userId) || 
                      (isSignedIn() && resource.data.userId == request.auth.uid) || 
                      (isSignedIn() && notificationId == 'follow_' + request.auth.uid);
        // The server writes notifications (functions/notification_delivery.js).
        // Clients: only admins (payout status) and the user themself — teachers
        // no longer write into students' inboxes (that was the second copy of
        // every reschedule notice). No more "userId == me" back door either:
        // anyone could put anything into anyone's inbox with it.
        allow create: if isAdmin() || isOwner(userId);
      }

      match /private/{document} {
        allow read, write: if isOwner(userId);
        // Admins read payout details to send teachers their money.
        allow read: if document == 'payout' && isAdmin();
      }
    }

    // =========================================================
    // 🎓 STUDENTS & TEACHERS
    // =========================================================
    match /students/{studentId} {
      allow read: if true;
      allow create: if (isOwner(studentId) && request.resource.data.role == 'student') || isAdmin();
      allow update: if isOwner(studentId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow read: if true;
      allow create: if !writesPayoutPublicly() &&
        ((isOwner(teacherId) && request.resource.data.role == 'teacher' && request.resource.data.status == 'pending') || isAdmin());
      allow update: if !writesPayoutPublicly() && (isAdmin() ||
        (isOwner(teacherId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalStars', 'reviewCount'])));
      allow delete: if isAdmin();
    }

    // =========================================================
    // ⭐ REVIEWS & RATINGS
    // =========================================================
    // ONE rating per student per course (id "<courseId>_<studentId>"), by an
    // enrolled student, after the course has ended, for that course's teacher.
    // Shape = Review.toDocument (lib/features/rating/domain). Totals: functions/ratings.js.
    match /reviews/{reviewId} {
      function validReview(d) {
        let course = get(/databases/$(database)/documents/courses/$(d.courseId)).data;
        return reviewId == d.courseId + '_' + request.auth.uid &&
          d.keys().hasOnly(['studentId', 'studentName', 'teacherId', 'courseId', 'courseName', 'rating', 'reviewText', 'timestamp', 'isPublic']) &&
          d.studentId == request.auth.uid &&
          request.auth.uid in course.get('enrolledStudents', []) &&
          d.teacherId == course.teacherId &&
          course.endDate < request.time &&
          d.rating is int && d.rating >= 1 && d.rating <= 5 &&
          d.get('reviewText', '') is string && d.get('reviewText', '').size() <= 1000 &&
          d.timestamp == request.time;
      }
      allow read: if true;
      allow create: if isSignedIn() && validReview(request.resource.data);
      // A rating is final (no re-rating to game totals); admins moderate.
      allow update, delete: if isAdmin();
    }

    // =========================================================
    // 💬 COURSES & ASSIGNMENTS
    // =========================================================
    match /courses/{courseId} {
      allow read: if true;

      // A new course is shaped like CourseDraft.toDocument (lib/features/courses/domain):
      // empty (enrolment is server-only), under the teacher's real name, server
      // time (no pinning a course to the top of the catalogue), and a store
      // product that matches its price (functions/purchases.js expectedProductId).
      function validNewCourse(d) {
        let me = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return d.teacherId == request.auth.uid &&
          d.get('enrolledStudents', []).size() == 0 &&
          d.get('enrolledCount', 0) == 0 &&
          d.get('teacherName', '') == me.get('name', '') &&
          d.price is number && d.price >= 0 &&
          (!('iapProductId' in d) || d.iapProductId == 'com.yazan.calligro.tier_' + string(int(d.price))) &&
          (!('maxStudents' in d) || (d.maxStudents is int && d.maxStudents >= 1)) &&
          (!('createdAt' in d) || d.createdAt == request.time || oldAppCreatedAtOk(d.createdAt));
      }

      // TEMPORARY OLD-APP BRIDGE — remove after the forced update (docs/KNOWN_ISSUES.md).
      // The store app (1.0.24) stamps new courses with the phone's clock; accept that
      // only within 10 minutes of the server's time (no backdating, no future dates).
      // To remove: delete this function and its use above (back to == request.time only).
      function oldAppCreatedAtOk(t) {
        return t is timestamp &&
          t > request.time - duration.value(10, 'm') &&
          t < request.time + duration.value(10, 'm');
      }

      // The owner may only reschedule a session, or carry their own new
      // name/photo onto the course (account deletion). Students, seats, price,
      // product and owner are server/admin-only once a course exists.
      function ownerUpdateOk() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let me = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return resource.data.teacherId == request.auth.uid &&
          changed.hasOnly(['rescheduledSession', 'teacherName', 'teacherProfilePic']) &&
          (!changed.hasAny(['teacherName']) || request.resource.data.teacherName == me.get('name', '')) &&
          (!changed.hasAny(['teacherProfilePic']) || request.resource.data.teacherProfilePic == me.get('photoUrl', null));
      }

      allow create: if isSignedIn() && (isApprovedTeacher() || isAdmin()) && validNewCourse(request.resource.data);
      allow update: if isAdmin() || (isSignedIn() && ownerUpdateOk());
      // Never delete a course people paid for (admins handle refunds/removals).
      allow delete: if isAdmin() || (isSignedIn() && resource.data.teacherId == request.auth.uid &&
        resource.data.get('enrolledStudents', []).size() == 0 &&
        resource.data.get('enrolledCount', 0) == 0);

      // Course content is for the people in the course.
      match /announcements/{announcementId} {
        allow read: if isCourseMember(courseId);
        allow create, update, delete: if isSignedIn() && (
          get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid ||
          isAdmin()
        );
      }

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/courses/$(courseId)).data.get('enrolledStudents', []) ||
          isAdmin()
        );
        // Exactly the shape CourseChatService writes (store app 1.0.24 writes the same).
        function chatProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
        // The name is the sender's own: full name, else name, else their sign-in name / "Member".
        function chatNameOk(d) {
          let me = chatProfile();
          let full = me.get('fullName', '').trim();
          let short = me.get('name', '').trim();
          return (full != '' && d.senderName == full) ||
            (short != '' && d.senderName == short) ||
            (full == '' && short == '' && (d.senderName == 'Member' || d.senderName == request.auth.token.get('name', '')));
        }
        // The photo is the sender's own profile / sign-in photo, or none.
        function chatPhotoOk(d) {
          let me = chatProfile();
          return d.get('senderPhotoUrl', null) == null ||
            d.senderPhotoUrl == me.get('photoUrl', '').trim() ||
            d.senderPhotoUrl == me.get('photoURL', '').trim() ||
            d.senderPhotoUrl == request.auth.token.get('picture', '');
        }
        // Images only from this course's chat folder, uploaded by the sender (Storage path
        // course_chats/<courseId>/<uid>_<time>.jpg) — never an outside link.
        function chatImageOk(d) {
          return d.get('imageUrl', null) == null ||
            (d.imageUrl is string && d.imageUrl.matches(
              'https://firebasestorage[.]googleapis[.]com/v0/b/[^/]+/o/course_chats%2F' + courseId + '%2F' + request.auth.uid + '_[^/?#]+([?].*)?'));
        }
        // The "teacher" / "admin" badge must be true (CourseChatService._resolveSenderRole),
        // the time is the server's, text up to 4000 characters, text or an image.
        allow create: if isSignedIn() &&
          request.resource.data.keys().hasOnly(['senderId', 'senderName', 'senderPhotoUrl', 'senderRole', 'text', 'imageUrl', 'createdAt']) &&
          request.resource.data.senderId == request.auth.uid &&
          isCourseMember(courseId) &&
          request.resource.data.get('createdAt', request.time) == request.time &&
          request.resource.data.get('text', '') is string &&
          request.resource.data.get('text', '').size() <= 4000 &&
          (request.resource.data.get('text', '').size() > 0 || request.resource.data.get('imageUrl', null) != null) &&
          request.resource.data.senderName is string && chatNameOk(request.resource.data) &&
          chatPhotoOk(request.resource.data) &&
          chatImageOk(request.resource.data) &&
          (request.resource.data.get('senderRole', 'student') == 'student' ||
            (request.resource.data.senderRole == 'teacher' &&
              get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid) ||
            (request.resource.data.senderRole == 'admin' && isAdmin()));
        allow delete: if isSignedIn() && (
          resource.data.senderId == request.auth.uid ||
          get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid ||
          isAdmin()
        );
        allow update: if false;
      }

      // Paid content: only people in the course.
      match /materials/{materialId} {
        allow read: if isCourseMember(courseId);
        allow create, update, delete: if isSignedIn() && (
          get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid ||
          isAdmin()
        );
      }

      // Assignments: the course's teacher (or an admin) manages them; members read them.
      match /assignments/{assignmentId} {
        allow read: if isCourseMember(courseId);
        allow create: if isSignedIn() &&
          (get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid || isAdmin()) &&
          request.resource.data.title is string && request.resource.data.title.size() > 0 &&
          request.resource.data.dueDate is timestamp;
        // (submissionCount is no longer written by clients: nobody reads it, and
        // any signed-in user could set it.)
        allow update, delete: if isSignedIn() &&
          (get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid || isAdmin());

        // One submission per enrolled student (doc id = their uid), changeable
        // until the due date. Students write only their own fields; the
        // teacher only marks/grades (app: seenByTeacher; web: status/points/feedback).
        match /submissions/{studentId} {
          function course() { return get(/databases/$(database)/documents/courses/$(courseId)).data; }
          function assignment() { return get(/databases/$(database)/documents/courses/$(courseId)/assignments/$(assignmentId)).data; }
          function isThisStudent() {
            return isSignedIn() && request.auth.uid == studentId &&
              request.auth.uid in course().get('enrolledStudents', []);
          }
          function isOpen() { return request.time < assignment().dueDate; }
          function isGrader() { return isSignedIn() && (course().teacherId == request.auth.uid || isAdmin()); }

          allow read: if (isSignedIn() && request.auth.uid == studentId) || isGrader();
          allow create: if isThisStudent() && isOpen() &&
            request.resource.data.keys().hasOnly(['note', 'fileUrl', 'fileName', 'submittedAt', 'studentName', 'studentImage', 'studentId']) &&
            request.resource.data.studentId == studentId &&
            request.resource.data.submittedAt == request.time;
          allow update: if (isThisStudent() && isOpen() &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note', 'fileUrl', 'fileName', 'submittedAt', 'studentName', 'studentImage']) &&
              request.resource.data.submittedAt == request.time) ||
            (isGrader() &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenByTeacher', 'status', 'points', 'feedback', 'gradedAt']));
          allow delete: if (isThisStudent() && isOpen()) || isAdmin();
        }
      }

      // 🔐 PRIVATE MEETING CREDENTIALS (Password & Room Link — enrolled only)
      match /private/{document} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid ||
          get(/databases/$(database)/documents/courses/$(courseId)).data.enrolledStudents.hasAny([request.auth.uid]) ||
          isAdmin()
        );
        // getAfter: written in the SAME batch as a new course (FirestoreCourseAuthoring.create).
        allow write: if isSignedIn() && (
          getAfter(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid ||
          isAdmin()
        );
      }

      // 🛡️ MEETING PRESENCE (Heartbeat-based duplicate detection)
      match /meetingPresence/{userId} {
        // Users can only read/write their own presence doc
        allow read: if isSignedIn() && (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid ||
          isAdmin()
        );
        allow create, update: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn() && (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid ||
          isAdmin()
        );
      }
      
      // 🛡️ MEETING ATTENDANCE
      match /meetingAttendance/{date}/participants/{userId} {
        allow read: if isSignedIn() && (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid ||
          isAdmin()
        );
        allow create, update: if false; // Only Cloud Functions can write attendance
        allow delete: if false;
      }
      
      // 🎥 CLASS RECORDINGS
      match /recordings/{recordingId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid ||
          get(/databases/$(database)/documents/courses/$(courseId)).data.enrolledStudents.hasAny([request.auth.uid]) ||
          isAdmin()
        );
        // The course's teacher may only rename (the file, status and links are the server's).
        allow update: if isSignedIn() &&
          get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title']);
        allow create, delete: if false; // Created by Cloud Functions
      }
    }

    // =========================================================
    // 💬 COMMUNITY POSTS
    // =========================================================
    // ---------------------------------------------------------
    // COMMUNITY (lib/features/community/data writes exactly these shapes;
    // functions/test/community_rules.test.js proves every rule below)
    // ---------------------------------------------------------
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // [field] moved by exactly +1 or -1 and is not negative.
    function stepsByOne(field) {
      return (request.resource.data[field] - resource.data.get(field, 0)) in [1, -1] &&
        request.resource.data[field] >= 0;
    }
    // A like toggle: only MY entry in the likes map changes, and likesCount
    // follows it (+1 when I add my like, -1 when I remove it).
    function isMyLikeToggle() {
      let before = resource.data.get('likes', {});
      let after = request.resource.data.get('likes', {});
      let me = request.auth.uid;
      let added = (me in after) && !(me in before);
      let removed = !(me in after) && (me in before);
      return after.diff(before).affectedKeys().hasOnly([me]) &&
        (!(me in after) || after[me] == true) &&
        (added || removed) &&
        request.resource.data.likesCount == resource.data.get('likesCount', 0) + (added ? 1 : -1);
    }
    // Comment / reply fields the author may change (edit + profile sync).
    function isOwnCommentEdit() {
      return isOwner(resource.data.userId) &&
        changedKeys().hasOnly(['text', 'isEdited', 'userName', 'userPhotoUrl', 'userRole']);
    }
    function postAuthor(postId) {
      return get(/databases/$(database)/documents/community_posts/$(postId)).data.userId;
    }

    match /community_posts/{postId} {
      allow read: if true;
      // Own post, empty counters; pin / hide / link only for admins.
      allow create: if isOwner(request.resource.data.userId) &&
        request.resource.data.likesCount == 0 &&
        request.resource.data.commentsCount == 0 &&
        request.resource.data.get('likes', {}).size() == 0 &&
        (isAdmin() || !request.resource.data.keys().hasAny(['isPinned', 'isHidden', 'linkUrl', 'linkTitle']));
      allow delete: if isOwner(resource.data.userId) || isAdmin();
      allow update: if isSignedIn() && (
        isAdmin() ||
        // The author: caption, images, edited flag, and the profile sync of name/photo/role.
        (isOwner(resource.data.userId) &&
          changedKeys().hasOnly(['caption', 'imageUrls', 'isEdited', 'userName', 'userImageUrl', 'userRole'])) ||
        // Anyone signed in: their own like, or the comment counter by one.
        (changedKeys().hasOnly(['likes', 'likesCount']) && isMyLikeToggle()) ||
        (changedKeys().hasOnly(['commentsCount']) && stepsByOne('commentsCount'))
      );

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isOwner(request.resource.data.userId);
        allow update: if isSignedIn() && (
          isOwnCommentEdit() ||
          (changedKeys().hasOnly(['replyCount']) && stepsByOne('replyCount'))
        );
        allow delete: if isSignedIn() && (
          isOwner(resource.data.userId) ||
          isOwner(postAuthor(postId)) ||
          isAdmin()
        );

        match /replies/{replyId} {
          // Public, like the comments they belong to.
          allow read: if true;
          allow create: if isOwner(request.resource.data.userId);
          allow update: if isOwnCommentEdit();
          // The post author too, so deleting a post can remove everyone's replies.
          allow delete: if isSignedIn() && (
            isOwner(resource.data.userId) ||
            isOwner(get(/databases/$(database)/documents/community_posts/$(postId)/comments/$(commentId)).data.userId) ||
            isOwner(postAuthor(postId)) ||
            isAdmin()
          );
        }
      }
    }

    // =========================================================
    // 📢 BROADCAST MESSAGES
    // =========================================================
    match /broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // =========================================================
    // 💰 WITHDRAWAL REQUESTS
    // =========================================================
    match /withdrawal_requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.teacherId == request.auth.uid || isAdmin());
      // Created only by the server from the real balance (functions/withdrawals.js
      // requestWithdrawal): the app used to write any amount it liked.
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // =========================================================
    // 🎨 GALLERY
    // =========================================================
    match /gallery_artists/{artistId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery_artworks/{artworkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================
    // 💰 TRANSACTIONS
    // =========================================================
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || 
        resource.data.teacherId == request.auth.uid || 
        isAdmin()
      );
      // Money records are written by Cloud Functions / the web server (Admin SDK).
      // Only admins may add one from a client (the development "join for free" button).
      allow create: if isAdmin() && request.resource.data.source == 'admin_bypass';
    }

    // Collection-group access for the profile sync (name / photo on all my comments).
    // Same edit set as the community rules — never the author (userId) itself.
    match /{path=**}/comments/{commentId} {
      allow read: if true;
      allow update: if isOwnCommentEdit();
    }

    // =========================================================
    // 🛡️ SECURITY & SYSTEM
    // =========================================================
    match /emailOtps/{email} {
      allow read, write: if false; // Only accessed via Admin SDK in Cloud Functions
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
      allow write: if false; // Only Cloud Functions write to orders
    }

    match /certificates/{certificateId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.studentId == request.auth.uid ||
        request.resource.data.teacherId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reportedByUserId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // =========================================================
    // ⚙️ APP CONFIG & VERSION CONTROL
    // =========================================================
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
// Force deploy
