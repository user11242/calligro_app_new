# ==============================================================================
# Calligro recording server (Contabo) — copy to .env and fill in. Never commit .env.
# ==============================================================================

# ── Fixed versions (update on purpose, after a test class) ───────────────────
LIVEKIT_SERVER_VERSION=v1.13.11
EGRESS_VERSION=v1.15.0
REDIS_VERSION=7.4-alpine
RCLONE_VERSION=1.75.2

# ── LiveKit (same key/secret as livekit.yaml and the Firebase secrets) ───────
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Cloudflare R2 (used by scripts/safety_check.sh to upload backed-up files) ─
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=calligro-recordings

# ── Safety checks (scripts/safety_check.sh, every 5 minutes) ─────────────────
# The Firebase function that alerts the admins (printed by the deploy):
ALERT_URL=https://us-central1-calligro-bcfb2.cloudfunctions.net/recordingSafety-recordingServerAlert
BACKUP_DIR=/opt/calligro-recordings/backup
DISK_ALERT_PERCENT=85
# Backed-up files are deleted from this server this many days after they reached R2:
BACKUP_KEEP_DAYS=7
